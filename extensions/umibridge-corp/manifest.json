{
  "manifest_version": 3,
  "name": "UmiBridge Corp - Chat Coordinator",
  "version": "0.2.1",
  "description": "Connect selected ChatGPT tabs to the local UmiBridge Corp queue. No cookies or account credentials are read.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*", "https://chatgpt.com/*", "https://chat.openai.com/*"],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "action": { "default_title": "UmiBridge Corp settings" },
  "content_scripts": [{ "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["content.js"], "run_at": "document_idle" }]
}
