{
  "manifest_version": 3,
  "name": "UmiBridge - Chrome, Corp & Arena",
  "version": "0.10.1",
  "description": "Chrome page control and separate Corp/Arena coordination through your paired local UmiBridge. Browser control is opt-in.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "UmiBridge Corp & Arena settings"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "model-picker.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ]
}
